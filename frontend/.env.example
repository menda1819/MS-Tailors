# Copy to .env.local and fill in. .env.local is gitignored.
# Only NEXT_PUBLIC_* values reach the browser — never put a secret behind that prefix.

# Base URL of the .NET Web API, no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# WhatsApp number in international format, digits only (Sri Lanka = 94).
NEXT_PUBLIC_WHATSAPP_NUMBER=94XXXXXXXXX

# Public origin of this site, used for canonical URLs, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
